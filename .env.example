# MongoDB connection string (local or MongoDB Atlas)
# Local example:  mongodb://127.0.0.1:27017/dr-data-collector
# Atlas example:  mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/dr-data-collector
MONGODB_URI=mongodb://127.0.0.1:27017/dr-data-collector

# Any long random string. Generate one with: openssl rand -base64 32
JWT_SECRET=replace_this_with_a_long_random_secret

# Folder holding the pre-generated screening reports (one subfolder per set,
# each with screening_report.pdf + *_attention.png / *_panels.png overlays).
REPORTS_DIR=C:\Pranav\college\sih\SIH_MathWorks_2026\reports

# Folder holding the source fundus images those reports were generated from.
# Used to match an upload by file content, so renamed files still match.
# Defaults to a "sets" folder beside REPORTS_DIR.
SETS_DIR=C:\Pranav\college\sih\SIH_MathWorks_2026\sets
